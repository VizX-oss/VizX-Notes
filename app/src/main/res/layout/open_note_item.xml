<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/open_note_item_holder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/m3_spacing_medium"
    android:layout_marginTop="@dimen/m3_spacing_small"
    android:layout_marginEnd="@dimen/m3_spacing_medium"
    android:layout_marginBottom="@dimen/m3_spacing_small"
    android:background="@drawable/m3_card_background"
    android:clipToOutline="true"
    android:elevation="@dimen/m3_card_elevation"
    android:paddingStart="@dimen/m3_spacing_medium"
    android:paddingTop="@dimen/m3_spacing_medium"
    android:paddingEnd="@dimen/m3_spacing_medium"
    android:paddingBottom="@dimen/m3_spacing_medium">

    <ImageView
        android:id="@+id/icon_lock"
        android:layout_width="match_parent"
        android:layout_height="@dimen/open_note_popup_lock_size"
        android:layout_below="@+id/open_note_item_title"
        android:importantForAccessibility="no"
        android:padding="@dimen/m3_spacing_small"
        android:src="@drawable/ic_lock_vector"
        android:visibility="gone" />

    <org.fossify.commons.views.MyTextView
        android:id="@+id/open_note_item_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginEnd="@dimen/m3_spacing_small"
        android:layout_toStartOf="@id/open_note_item_icon"
        android:ellipsize="end"
        android:lines="1"
        android:textSize="@dimen/big_text_size"
        android:textStyle="bold"
        tools:text="Title" />

    <ImageView
        android:id="@+id/open_note_item_icon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_alignTop="@id/open_note_item_title"
        android:layout_alignParentEnd="true"
        android:contentDescription="@string/this_note_is_linked"
        android:foreground="@drawable/ripple_all_corners"
        android:padding="12dp"
        android:src="@drawable/ic_link_vector" />

    <org.fossify.commons.views.MyTextView
        android:id="@+id/open_note_item_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/open_note_item_title"
        android:layout_alignParentStart="true"
        android:layout_marginTop="@dimen/m3_spacing_small"
        android:ellipsize="end"
        android:maxHeight="@dimen/grid_note_item_max_height"
        tools:text="text" />

</RelativeLayout>
