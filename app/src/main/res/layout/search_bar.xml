<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/search_holder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/m3_spacing_medium"
    android:layout_marginTop="@dimen/m3_spacing_small"
    android:layout_marginEnd="@dimen/m3_spacing_medium"
    android:layout_marginBottom="@dimen/m3_spacing_small"
    android:background="@drawable/m3_pill_background"
    android:elevation="2dp"
    android:paddingStart="@dimen/m3_spacing_medium"
    android:paddingEnd="@dimen/m3_spacing_medium"
    android:visibility="gone">

    <ImageView
        android:id="@+id/search_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:contentDescription="@string/search"
        android:src="@drawable/ic_search_vector"
        app:tint="?attr/colorOnSurfaceVariant" />

    <org.fossify.commons.views.MyEditText
        android:id="@+id/search_query"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/m3_spacing_small"
        android:layout_toStartOf="@+id/search_buttons_holder"
        android:layout_toEndOf="@id/search_icon"
        android:background="@null"
        android:hint="@string/search"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:singleLine="true"
        android:textColor="?attr/colorOnSurface"
        android:textColorHint="?attr/colorOnSurfaceVariant"
        android:textSize="16sp" />

    <LinearLayout
        android:id="@+id/search_buttons_holder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/search_previous"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/previous"
            android:padding="8dp"
            android:src="@drawable/ic_chevron_up_vector"
            app:tint="?attr/colorOnSurfaceVariant" />

        <ImageView
            android:id="@+id/search_next"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/next"
            android:padding="8dp"
            android:src="@drawable/ic_chevron_down_vector"
            app:tint="?attr/colorOnSurfaceVariant" />

        <ImageView
            android:id="@+id/search_clear"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/clear"
            android:padding="8dp"
            android:src="@drawable/ic_cross_vector"
            app:tint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>
</RelativeLayout>
