<resources>

    <style name="AppTheme" parent="AppTheme.Base">
        <item name="cornerFamily">rounded</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.M3.Corner.ExtraLarge</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.M3.Corner.Large</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.M3.Corner.Medium</item>
        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.M3.Corner.Small</item>
    </style>

    <!-- Shape Appearances for MD3 -->
    <style name="ShapeAppearance.M3.Corner.ExtraLarge" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerSize">@dimen/m3_dialog_corner_radius</item>
    </style>

    <style name="ShapeAppearance.M3.Corner.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">@dimen/m3_card_corner_radius</item>
    </style>

    <style name="ShapeAppearance.M3.Corner.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">@dimen/m3_input_corner_radius</item>
    </style>

    <style name="ShapeAppearance.M3.Corner.Small" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerSize">@dimen/m3_spacing_small</item>
    </style>

    <!-- Base Parent Style for AAPT2 resolution -->
    <style name="Widget.Notes" />

    <!-- Component Styles -->
    <style name="Widget.Notes.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/m3_card_corner_radius</item>
        <item name="cardElevation">@dimen/m3_card_elevation</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.M3.Corner.Large</item>
    </style>

    <style name="Widget.Notes.FloatingActionButton" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.M3.Corner.Large</item>
    </style>

    <style name="Widget.Notes.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/m3_input_corner_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/m3_input_corner_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/m3_input_corner_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/m3_input_corner_radius</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.M3.Corner.Medium</item>
    </style>

    <style name="Widget.Notes.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="cornerRadius">@dimen/m3_chip_corner_radius</item>
    </style>

    <style name="Widget.Notes.PillButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/m3_pill_background</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:paddingStart">@dimen/m3_spacing_medium</item>
        <item name="android:paddingEnd">@dimen/m3_spacing_medium</item>
        <item name="android:paddingTop">@dimen/m3_spacing_small</item>
        <item name="android:paddingBottom">@dimen/m3_spacing_small</item>
    </style>

</resources>
